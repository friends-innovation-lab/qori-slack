# Qori Backend — monorepo-aware Docker build.
#
# Build context: repo root (not backend/).
# Railway config: Dockerfile path = Dockerfile.backend
#
# Installs npm workspaces from root, then builds backend.
# The api-contracts package is resolved via workspace linking.

FROM node:20-alpine

# Install build dependencies
RUN apk add --no-cache python3 make g++

WORKDIR /app

# Copy workspace root
COPY package.json package-lock.json ./

# Copy workspace packages needed by backend
COPY packages/api-contracts/package.json ./packages/api-contracts/package.json
COPY packages/api-contracts/tsconfig.json ./packages/api-contracts/tsconfig.json
COPY packages/api-contracts/src/ ./packages/api-contracts/src/

# Copy backend
COPY backend/package.json backend/package-lock.json* ./backend/

# Install all workspace dependencies from root
RUN npm ci --legacy-peer-deps

# Build api-contracts first (backend may import compiled output)
RUN npm run build --workspace=packages/api-contracts 2>/dev/null || true

# Copy backend source
COPY backend/ ./backend/

# Build backend (Babel compiles .js and .ts from src/ to dist/)
RUN cd backend && npm run build

WORKDIR /app/backend

EXPOSE 3000

ENV NODE_ENV=production

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3000/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})" || exit 1

# Run migrations on startup, then start the app
CMD ["sh", "./scripts/start.sh"]
